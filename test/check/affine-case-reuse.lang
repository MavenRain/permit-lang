def cb : (Budget -o FreeMon Unit) -> FreeMon Budget -o FreeMon Unit :=
  fun k t => fold (fun (a : Budget) => fmMul Unit (k a) (k a)) (fmUnit Unit) (fun (x : FreeMon Unit) (y : FreeMon Unit) => fmMul Unit x y) (fun (x : FreeMon Unit) (y : FreeMon Unit) (z : FreeMon Unit) (i : I) => fmAssoc Unit x y z i) (fun (x : FreeMon Unit) (i : I) => fmUnitL Unit x i) (fun (x : FreeMon Unit) (i : I) => fmUnitR Unit x i) (fun (x : FreeMon Unit) (y : FreeMon Unit) (p : Path (FreeMon Unit) x y) (q : Path (FreeMon Unit) x y) (i : I) (j : I) => fmSquash Unit x y p q i j) t
