-- REFUSE_EXECUTE_UNAPPROVED (Q-S7-8 (a), L5): the execute of m1 lies in
-- the ppApproved branch of a propose of another mutation (m2).
def m1 : Mutation := mutation (resRoot 1) execute (payloadOf 7)

def m2 : Mutation := mutation (resRoot 2) execute (payloadOf 7)

def stop : Plan Unit := planDone Unit unit

def bad : Plan Unit := planPropose Unit m2 (planExecute Unit m1 stop stop stop) stop
