-- S11 U3 report and cedar row (Q-S11-6 (a)): the scope of scope.lang and 60
-- binds. The report line has 9959 bytes, so the JCS buffer (start 4096)
-- doubles 2 times. No other row has a report line over 4096 bytes.
def docs : Resource := res "docs"

def report : Resource := res "docs/report"

def outbox : Resource := res "mail/out"

def left : Scope :=
  fmMul (Prod Resource Action) (fmEta (Prod Resource Action) (pair docs inspect)) (fmEta (Prod Resource Action) (pair report propose))

def sc : Scope :=
  fmMul (Prod Resource Action) left (fmMul (Prod Resource Action) (fmEta (Prod Resource Action) (pair report execute)) (fmEta (Prod Resource Action) (pair outbox execute)))

def start : Authority := authority sc (szS (szS (szS sz0))) 7 (fmUnit Digest)

