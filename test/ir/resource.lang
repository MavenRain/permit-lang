-- The entries use within, resEq, envelope and hash at run time (S8,
-- Q-S8-2 (a), Q-S8-3 (a)). A closed res chain is the index of its path
-- literal in program order: "a/b" is 0, "c" is 1, "a" is 2 ("a/b" does
-- not enter "a"). within, envelope and hash call the host imports
-- permit.within, permit.envelope and permit.hash; resEq is i64.eq. The IR
-- text is test/ir/resource.ir.
def under : (n : Nat) -> Nat :=
  fun (n : Nat) => flagIf (within (flagIf (natEq n 0) res "a/b" res "c") res "a") 1 0

def same : (n : Nat) -> Nat :=
  fun (n : Nat) => flagIf (resEq (flagIf (natEq n 0) res "a/b" res "c") res "c") 1 0

def digest : (n : Nat) -> Nat :=
  fun (n : Nat) => flagIf (digestEq (hash (envelope res "a/b" (payloadOf n))) (hash (envelope res "a/b" (payloadOf 3)))) 1 0
