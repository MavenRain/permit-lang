func under (nat) -> nat, 5 locals, 0 heap words
  l3 := eq(l0, 0)
  if l3 {
    l2 := 0
  } else {
    l2 := 1
  }
  l4 := call permit.within(l2, 2)
  if l4 {
    l1 := 1
  } else {
    l1 := 0
  }
  return l1
func same (nat) -> nat, 5 locals, 0 heap words
  l3 := eq(l0, 0)
  if l3 {
    l2 := 0
  } else {
    l2 := 1
  }
  l4 := eq(l2, 1)
  if l4 {
    l1 := 1
  } else {
    l1 := 0
  }
  return l1
func digest (nat) -> nat, 7 locals, 0 heap words
  l2 := call permit.envelope(0, l0)
  l3 := call permit.hash(l2)
  l4 := call permit.envelope(0, 3)
  l5 := call permit.hash(l4)
  l6 := eq(l3, l5)
  if l6 {
    l1 := 1
  } else {
    l1 := 0
  }
  return l1
res 0 "a/b"
res 1 "c"
res 2 "a"
